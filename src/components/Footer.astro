---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-meta">
		<p>&copy; {today.getFullYear()} GiftyPaper · Tutti i diritti riservati.</p>
		<div class="footer-links">
			<a href="/privacy">Privacy & Cookie</a>
		</div>
	</div>
	<div class="footer-socials">
		<a href="https://www.tiktok.com/@giftypaper" target="_blank" rel="noreferrer">TikTok</a>
		<a href="https://www.instagram.com/giftypaper" target="_blank" rel="noreferrer">Instagram</a>
	</div>
</footer>
<script>
	(() => {
		const root = document.documentElement;
		const baseMid = [255, 240, 140];
		const baseEnd = [255, 205, 65];
		const targetMid = [25, 75, 45];
		const targetEnd = [15, 48, 30];
		const lerp = (from, to, ratio) => Math.round(from + (to - from) * ratio);

		const prefersDarkQuery = window.matchMedia('(prefers-color-scheme: dark)');
		const lightTextTone = 'rgba(var(--ink), 0.82)';
		const lightMetaTone = 'rgba(var(--ink), 0.65)';
		const darkTextTone = 'rgba(255, 255, 255, 0.92)';
		const darkMetaTone = 'rgba(255, 255, 255, 0.72)';
		const applyThemeTone = (isDark) => {
			root.style.setProperty('--footer-text-color', isDark ? darkTextTone : lightTextTone);
			root.style.setProperty('--footer-meta-color', isDark ? darkMetaTone : lightMetaTone);
		};
		applyThemeTone(prefersDarkQuery.matches);
		if (typeof prefersDarkQuery.addEventListener === 'function') {
			prefersDarkQuery.addEventListener('change', (event) => applyThemeTone(event.matches));
		} else if (typeof prefersDarkQuery.addListener === 'function') {
			prefersDarkQuery.addListener((event) => applyThemeTone(event.matches));
		}

		const lightLinkColor = 'rgba(255, 255, 255, 0.95)';
		const darkLinkColor = 'rgb(var(--ink))';
		const update = () => {
			const docHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
			const viewport = window.innerHeight;
			const maxScroll = Math.max(docHeight - viewport, 1);
			const ratio = Math.min(1, window.scrollY / maxScroll);
			const mid = baseMid.map((value, idx) => lerp(value, targetMid[idx], ratio)).join(',');
			const end = baseEnd.map((value, idx) => lerp(value, targetEnd[idx], ratio)).join(',');
			root.style.setProperty('--bg-mid', mid);
			root.style.setProperty('--bg-end', end);
			const linkColor = ratio > 0.5 ? lightLinkColor : darkLinkColor;
			const borderColor = ratio > 0.5 ? 'rgba(255, 255, 255, 0.6)' : 'rgba(var(--ink), 0.4)';
			root.style.setProperty('--footer-link-color', linkColor);
			root.style.setProperty('--footer-link-border', borderColor);
		};

		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		update();
	})();
</script>
<style>
	.site-footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		padding: 2rem 1rem 3rem;
		color: var(--footer-text-color, rgba(var(--ink), 0.8));
		text-align: center;
	}

	.footer-meta {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		align-items: center;
	}

	.footer-meta p {
		margin: 0;
		color: var(--footer-meta-color, rgba(var(--ink), 0.65));
	}

	.footer-links {
		display: flex;
		gap: 0.5rem;
	}

	.footer-links a {
		text-transform: uppercase;
		letter-spacing: 0.3em;
		font-size: 0.7rem;
		color: var(--footer-link-color, rgb(var(--rosewood)));
		text-decoration: none;
		border-bottom: 1px solid transparent;
		border-color: var(--footer-link-border, rgba(var(--rosewood), 0.4));
		padding-bottom: 0.1rem;
	}

	.footer-links a:hover {
		border-color: var(--footer-link-border, rgb(var(--rosewood)));
	}

	.footer-socials {
		display: inline-flex;
		gap: 1rem;
	}

	.footer-socials a {
		text-transform: uppercase;
		font-size: 0.8rem;
		letter-spacing: 0.3em;
		text-decoration: none;
		color: var(--footer-link-color, rgb(var(--rosewood)));
		border-bottom: 1px solid transparent;
		border-color: var(--footer-link-border, rgba(var(--rosewood), 0.4));
		padding-bottom: 0.1rem;
	}

	.footer-socials a:hover {
		border-color: var(--footer-link-border, rgb(var(--rosewood)));
	}
</style>
