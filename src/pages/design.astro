---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { designCollections } from '../content/designs';

const designCollectionJson = JSON.stringify(designCollections).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="it">
	<head>
		<BaseHead
			title="Design | GiftyPaper"
			description="Scopri i design firmati GiftyPaper."
		/>
	</head>
	<body>
		<Header />
		<main class="site-shell">
			<section class="hero hero-fdp">
				<p class="hero-tag">Festa del Papà Collection</p>
				<h1>Design</h1>
				<p class="hero-lead">
					Scopri i design firmati GiftyPaper e componi il tuo kit da qui.
				</p>
			</section>

			<section class="design-collections" aria-label="Catalogo delle grafiche protette">
				{designCollections.map((collection) => (
					<article class={`design-collection${collection.style === 'love' ? ' love' : ''}`} key={collection.id}>
						<header class="design-collection-header">
							<p class={`hero-tag${collection.tagVariant ? ` ${collection.tagVariant}` : ''}`}>
								{collection.tag}
							</p>
							<h2>{collection.title}</h2>
							<p>{collection.description}</p>
						</header>
						<div class="design-grid" aria-label={`Anteprime ${collection.title}`}>
						{collection.kits.map((kit) => (
							<article class="design-card" key={kit.id} data-kit={kit.id}>
								<div class={`design-thumb${kit.previewVisible ? ' is-ready' : ''}`} role="presentation" oncontextmenu="return false;">
									{kit.previewImage ? (
										<img
											src={kit.previewImage}
											alt={`Anteprima ${kit.title}`}
											loading="lazy"
											decoding="async"
											draggable="false"
										/>
									) : null}
								</div>
									<div>
										<h3>{kit.title}</h3>
										<p>{kit.description}</p>
										<p>{kit.detail}</p>
									</div>
									<div class="design-actions">
										<a class="btn-pill alt pink-text" href={`/compose?design=${kit.id}`}>
											Componimi
										</a>
									</div>
								</article>
							))}
						</div>
					</article>
				))}
			</section>

			<div class="preview-modal" aria-hidden="true">
				<div class="preview-card">
					<button type="button" class="modal-close" aria-label="Chiudi">×</button>
					<p>
						Trova la password all'interno dei nostri contenuti TikTok o Instagram, poi inseriscila nel form
						per sbloccare l'anteprima.
					</p>
					<div class="modal-socials">
						<a href="https://www.tiktok.com/@giftypaper" target="_blank" rel="noreferrer">TikTok</a>
						<a href="https://www.instagram.com/giftypaper" target="_blank" rel="noreferrer">Instagram</a>
					</div>
					<form class="modal-form">
						<label>
							<span>Password</span>
							<input type="password" name="password" autocomplete="off" required />
						</label>
						<button type="submit" class="btn-pill alt pink-text">INVIO</button>
					</form>
					<p class="modal-feedback" role="status"></p>
				</div>
			</div>
		</main>
		<Footer />
		<script id="design-data" type="application/json" set:html={designCollectionJson}></script>
		<script type="module">
			(() => {
				const dataElement = document.querySelector('#design-data');
				const collections = JSON.parse(dataElement?.textContent ?? '[]');
				const kits = collections.flatMap((collection) => collection.kits);
				const modal = document.querySelector('.preview-modal');
				const feedback = modal?.querySelector('.modal-feedback');
				const form = modal?.querySelector('.modal-form');
				const close = modal?.querySelector('.modal-close');
				let currentId = null;

				const toggleModal = (show) => {
					if (show) {
						modal?.classList.add('active');
						modal?.setAttribute('aria-hidden', 'false');
					} else {
						modal?.classList.remove('active');
						modal?.setAttribute('aria-hidden', 'true');
						currentId = null;
					}
				};

				document.querySelectorAll('.preview-btn').forEach((btn) => {
					btn.addEventListener('click', () => {
						currentId = btn.dataset.kit;
						form?.reset();
						if (feedback) feedback.textContent = '';
						toggleModal(true);
					});
				});

				close?.addEventListener('click', () => toggleModal(false));

				form?.addEventListener('submit', (event) => {
					event.preventDefault();
					const value = (form.password.value ?? '').trim();
					const kit = kits.find((item) => item.id === currentId);
					if (!kit) return;
					if (value.toLowerCase() === kit.password.toLowerCase()) {
						const card = document.querySelector(`[data-kit="${kit.id}"] .design-thumb`);
						if (card) {
							card.classList.add('is-ready');
							card.classList.add('unlocked');
						}
						if (feedback) feedback.textContent = "Password corretta, ora vedi l'anteprima.";
						setTimeout(() => toggleModal(false), 900);
					} else if (feedback) {
						feedback.textContent = 'Password errata, controlla TikTok o Instagram.';
					}
				});
			})();
		</script>
	</body>
</html>
